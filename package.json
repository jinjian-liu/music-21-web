{
  "name": "music-21-web",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:server": "tsx watch server/index.ts",
    "server": "tsx server/index.ts",
    "db:migrate": "tsx server/migrate.ts",
    "build": "tsc --noEmit -p tsconfig.app.json && tsc --noEmit -p tsconfig.server.json && vite build",
    "build:web": "tsc --noEmit -p tsconfig.app.json && vite build",
    "build:server": "tsc --noEmit -p tsconfig.server.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "worker": "tsx server/worker.ts",
    "dev:worker": "tsx watch server/worker.ts",
    "test:e2e": "playwright test",
    "admin:create": "tsx server/admin.ts"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1136.0",
    "@aws-sdk/s3-request-presigner": "^3.1136.0",
    "@fastify/cookie": "^10.0.1",
    "@fastify/cors": "^11.3.0",
    "@node-rs/argon2": "^2.2.1",
    "@tonejs/midi": "^2.0.28",
    "dotenv": "^18.0.1",
    "drizzle-orm": "^0.45.2",
    "fastify": "^5.12.5",
    "pg": "^8.23.0",
    "react": "19.1.1",
    "react-dom": "19.1.1",
    "react-router-dom": "^7.18.4",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.8",
    "@playwright/test": "^1.63.0",
    "@testing-library/jest-dom": "6.6.3",
    "@testing-library/react": "16.3.0",
    "@types/pg": "^8.23.1",
    "@types/react": "19.1.12",
    "@types/react-dom": "19.1.9",
    "@vitejs/plugin-react": "4.3.4",
    "fake-indexeddb": "^6.2.5",
    "jsdom": "25.0.1",
    "prettier": "^3.9.9",
    "tsx": "^4.23.14",
    "typescript": "5.7.3",
    "vite": "6.1.0",
    "vitest": "2.1.9"
  }
}
